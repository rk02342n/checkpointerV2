# Kinde native application (create a new "Native" app in the Kinde dashboard —
# do NOT reuse the web app's client, it has a secret and different callbacks).
EXPO_PUBLIC_KINDE_DOMAIN=https://yourbusiness.kinde.com
EXPO_PUBLIC_KINDE_CLIENT_ID=your-native-app-client-id

# API base URL. Leave unset for Expo Go development — the app derives your
# machine's LAN IP from the dev server automatically. Set for real builds.
# EXPO_PUBLIC_API_URL=https://checkpointer.io
